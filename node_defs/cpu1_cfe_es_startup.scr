CFE_APP, link_lab, LINK_LAB_AppMain, LINK_LAB, 60, 16384, 0x0, 0;
CFE_APP, step_lab, STEP_LAB_AppMain, STEP_LAB, 70, 16384, 0x0, 0;
!
! Startup script fields:
! 1. Object Type      -- CFE_APP for an Application, or CFE_LIB for a library.
! 2. Path/Filename    -- Virtual filename (standard path /cf, default extension .so)
! 3. Entry Point      -- Entry point symbol
! 4. CFE Name         -- The cFE name for the APP or Library
! 5. Priority         -- Priority of the App
! 6. Stack Size       -- Stack size for the App (16384 bytes)
! 7. Load Address     -- 0x0
! 8. Exception Action -- 0 = restart app, non-zero = processor reset
